{
    "name": "next-app-starter",
    "version": "0.1.0",
    "description": "Domain-neutral Next.js App Router starter with token-driven design system.",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "format": "prettier --write .",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "codemod:extract-hooks": "jiti tools/codemods/run-extract-transport-to-hook.ts",
        "contract": "jiti tools/contract/run-generate-contract.ts",
        "contract:check": "jiti tools/contract/run-generate-contract.ts --check",
        "design:audit": "jiti tools/design-audit/run-design-audit.ts",
        "lint": "eslint",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{js,mjs,json,css,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@tanstack/react-query": "^5.101.2",
        "axios": "^1.18.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.25.0",
        "motion": "^12.42.2",
        "next": "16.2.10",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "server-only": "^0.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4",
        "@tanstack/react-query-devtools": "^5.101.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/rule-tester": "^8.66.0",
        "@typescript-eslint/utils": "^8.66.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^9",
        "eslint-config-next": "16.2.10",
        "fast-check": "^4.10.2",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "jsdom": "^30.0.1",
        "lint-staged": "^17.1.0",
        "prettier": "^3.9.5",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4",
        "ts-morph": "^28.0.0",
        "typescript": "^5",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.1.10"
    }
}
